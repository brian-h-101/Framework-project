{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Custom Tree View Extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"${workspaceFolder}/../../../framework-project"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			]
		}
	]
}