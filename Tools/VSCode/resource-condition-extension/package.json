{
	"name": "resource-condition-extension",
	"displayName": "Resource Condition Extension",
	"description": "Resource discovery and assignment run the project's Godot scripts.",
	"version": "0.0.4",
	"publisher": "framework-tools",
	"type": "commonjs",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false,
			"description": "Resource discovery runs the project's Godot exporter."
		}
	},
	"engines": {
		"vscode": "^1.146.0"
	},
	"categories": [
		"Other"
	],
	"main": "./out/extension.js",
	"scripts": {
		"compile": "tsc -p .",
		"vscode:prepublish": "npm run compile",
		"package:list": "vsce ls --no-dependencies",
		"package:vsix": "vsce package --no-dependencies --allow-missing-repository --skip-license"
	},
	"contributes": {
		"views": {
			"explorer": [
				{
					"id": "customTreeView.resources",
					"name": "Framework Resources"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "customTreeView.resources",
				"contents": "Open a framework .tres file to view its relationships."
			}
		],
		"commands": [
			{
				"command": "customTreeView.refresh",
				"title": "Refresh Resources",
				"category": "Resource Conditions",
				"icon": "$(refresh)"
			},
			{
				"command": "customTreeView.addConditionToGroup",
				"title": "Add Condition to Group...",
				"category": "Resource Conditions"
			},
			{
				"command": "customTreeView.setInteractionRequirements",
				"title": "Set Interaction Requirements...",
				"category": "Resource Conditions"
			},
			{
				"command": "customTreeView.setInteractionAction",
				"title": "Set Interaction Action...",
				"category": "Resource Conditions"
			},
			{
				"command": "customTreeView.editCondition",
				"title": "Edit Condition...",
				"category": "Resource Conditions"
			},
			{
				"command": "customTreeView.openResource",
				"title": "Open Resource",
				"category": "Resource Conditions"
			}
		],
		"submenus": [
			{
				"id": "customTreeView.resourceMenu",
				"label": "Framework Resources"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "customTreeView.openResource",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "customTreeView.refresh",
					"when": "view == customTreeView.resources",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"submenu": "customTreeView.resourceMenu",
					"when": "view == customTreeView.resources && viewItem =~ /^(interaction|action|condition_group|condition)$/",
					"group": "framework@1"
				}
			],
			"customTreeView.resourceMenu": [
				{
					"command": "customTreeView.openResource",
					"group": "1_open@1"
				},
				{
					"command": "customTreeView.setInteractionAction",
					"when": "viewItem == interaction",
					"group": "2_assign@1"
				},
				{
					"command": "customTreeView.setInteractionRequirements",
					"when": "viewItem == interaction",
					"group": "2_assign@2"
				},
				{
					"command": "customTreeView.addConditionToGroup",
					"when": "viewItem == condition_group",
					"group": "2_assign@1"
				},
				{
					"command": "customTreeView.editCondition",
					"when": "viewItem == condition",
					"group": "3_edit@1"
				}
			]
		}
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"@types/vscode": "1.146.0",
		"@vscode/vsce": "4.1.1",
		"typescript": "7.0.2"
	}
}
