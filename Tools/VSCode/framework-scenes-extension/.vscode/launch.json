{
	"version": "0.2.0",
	"configurations": [{
		"name": "Run Framework Scenes",
		"type": "extensionHost",
		"request": "launch",
		"runtimeExecutable": "${execPath}",
		"args": [
			"--extensionDevelopmentPath=${workspaceFolder}",
			"${workspaceFolder}/../../../framework-project"
		],
		"preLaunchTask": "compile",
		"outFiles": ["${workspaceFolder}/out/**/*.js"]
	}]
}
