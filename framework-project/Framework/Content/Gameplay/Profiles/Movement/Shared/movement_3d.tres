[gd_resource type="Resource" load_steps=5 format=3]

[ext_resource type="Script" path="res://Framework/Content/Universal/Movement/based/Configuration/movement_profile.gd" id="1_profile"]
[ext_resource type="Script" path="res://Framework/Content/Universal/Movement/based/Physics3D/physics_3d_spec.gd" id="2_environment"]
[ext_resource type="Resource" path="res://Framework/Content/Gameplay/Profiles/Movement/Behavior/move.tres" id="3_behavior"]

[sub_resource type="Resource" id="Resource_environment"]
script = ExtResource("2_environment")
units_per_gameplay_unit = 0.1

[resource]
script = ExtResource("1_profile")
environment_spec = SubResource("Resource_environment")
movement_behavior = ExtResource("3_behavior")
velocity_step_id = &"calculate_velocity"
