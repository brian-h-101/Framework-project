[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://Framework/Infrastructure/API/Entity/Resources/starting_attributes_resource.gd" id="1_schema"]

[ext_resource type="Script" path="res://Framework/Infrastructure/API/Entity/Resources/container_fragment_resource.gd" id="2_fragment_type"]
[ext_resource type="Resource" path="res://Framework/Content/Authored/Entity/Attributes/Identity/identity.tres" id="fragment_01"]
[ext_resource type="Resource" path="res://Framework/Content/Authored/Entity/Container/inventory.tres" id="fragment_02"]
[ext_resource type="Resource" path="res://Framework/Content/Authored/Items/State/Condition/condition.tres" id="fragment_03"]
[ext_resource type="Resource" path="res://Framework/Content/Authored/Objects/Attributes/Structure/structure.tres" id="fragment_04"]
[ext_resource type="Resource" path="res://Framework/Content/Authored/Objects/State/Access/access.tres" id="fragment_05"]

[resource]
script = ExtResource("1_schema")
id = &"wooden_chest"
fragments = Array[ExtResource("2_fragment_type")]([
	ExtResource("fragment_01"),
	ExtResource("fragment_02"),
	ExtResource("fragment_03"),
	ExtResource("fragment_04"),
	ExtResource("fragment_05"),
])
overrides = {
	&"identity": {"name": "Wooden Chest"},
	&"inventory": {"capacity": 12},
	&"structure": {
		"material": "wood",
		"destructible": true,
	},
	&"access": {"locked": true},
}
