[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://Framework/Infrastructure/API/Gameplay/Resources/action_resource.gd" id="1_action"]

[resource]
script = ExtResource("1_action")
id = &"change_health"
effects = Array[Dictionary]([{
	"operation": &"add",
	"entity": &"target",
	"container": &"health",
	"path": ["current"],
	"value_from": &"amount"
}])